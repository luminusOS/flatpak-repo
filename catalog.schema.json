{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Luminus Flatpak repository catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format", "architectures", "channels", "applications"],
  "properties": {
    "schema_version": {"const": 1},
    "format": {"const": "flatpak"},
    "architectures": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": {"enum": ["x86_64", "aarch64"]}
    },
    "channels": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": {"enum": ["stable", "testing"]}
    },
    "applications": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source"],
        "properties": {
          "id": {"type": "string", "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9-]*(\\.[A-Za-z][A-Za-z0-9-]*){2,}$(?![\\s\\S])"},
          "source": {
            "type": "object", "additionalProperties": false,
            "required": ["repository", "workflow"],
            "properties": {
              "repository": {"type": "string", "maxLength": 100, "pattern": "^luminusOS/[a-z0-9]+(?:-[a-z0-9]+)*$(?![\\s\\S])"},
              "workflow": {"type": "string", "maxLength": 128, "pattern": "^\\.github/workflows/[A-Za-z0-9][A-Za-z0-9._-]*\\.ya?ml$(?![\\s\\S])"}
            }
          }
        }
      }
    }
  }
}
